# =============================================================================
# Liberty Server Environment Variables
# These values are used by server.xml via ${env.VAR_NAME:default} substitution.
# In OpenShift, override these via Secrets/ConfigMaps mounted as env vars
# in the WebSphereLibertyApplication CR or Deployment spec.
# =============================================================================

# TLS keystore password — override via OpenShift Secret in production.
# The Liberty Operator can mount secrets as env vars:
#   env:
#     - name: KEYSTORE_PASSWORD
#       valueFrom:
#         secretKeyRef:
#           name: liberty-tls
#           key: keystore-password
KEYSTORE_PASSWORD=liberty

# JVM tuning for container environments.
# OpenJ9 detects container memory limits automatically via -XX:+UseContainerSupport
# (enabled by default). These options provide additional tuning:
#   -Xshareclasses: Share compiled classes across container restarts (faster startup)
#     cacheDir must be writable by the random UID that OpenShift's restricted-v2 SCC
#     assigns. /tmp is always writable; /output/.classCache is not (created as UID 1001
#     at build time, but the pod runs as a namespace-range UID).
#   -Xquickstart: Optimize for fast startup over peak throughput
JVM_ARGS=-Xshareclasses:cacheDir=/tmp/.classCache -Xquickstart

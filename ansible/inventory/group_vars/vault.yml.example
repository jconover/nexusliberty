---
# vault.yml.example — Ansible Vault template for sensitive variables
#
# Usage:
#   1. Copy this file: cp vault.yml.example vault.yml
#   2. Set real values below
#   3. Encrypt it: ansible-vault encrypt inventory/group_vars/vault.yml
#   4. Run playbooks with: ansible-playbook ... --ask-vault-pass
#      or set ANSIBLE_VAULT_PASSWORD_FILE in your environment
#
# all.yml references these via {{ vault_was_admin_password }} with a
# fallback default for demo use. In production, always use vault.

vault_was_admin_password: "CHANGE_ME_use_vault_encrypt"
